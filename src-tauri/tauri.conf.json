{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlumiLauncher",
  "mainBinaryName": "AlumiLauncher",
  "version": "1.0.0",
  "identifier": "AlumiLauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AlumiLauncher",
        "width": 520,
        "height": 720,
        "resizable": true,
        "minWidth": 240,
        "minHeight": 60,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msEdgeSync,OptimizationHints,Translate,msEdgeAutofill --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --disable-breakpad --no-pings --no-first-run --metrics-recording-only --proxy-server=http://127.0.0.1:9",
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://widget.localhost https://widget.localhost http://miniapp.localhost https://miniapp.localhost; connect-src ipc: http://ipc.localhost; media-src http://miniapp.localhost https://miniapp.localhost blob: data:; frame-src http://widget.localhost https://widget.localhost widget: http://miniapp.localhost https://miniapp.localhost miniapp:; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Almirucan-Ito",
    "shortDescription": "Home-screen style app launcher",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": { "../LICENSE": "LICENSE.txt", "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md" },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "template": "installer/installer.nsi",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
